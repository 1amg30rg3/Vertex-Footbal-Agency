Options -Indexes +FollowSymLinks

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never serve dotfiles (.env, .git, .gitignore, ...)
    RewriteRule ^\. - [F,L]

    # Never serve project metadata or database dumps
    RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|vite\.config\.js|README\.md|.*\.sql)$ - [F,L]

    # Admin-uploaded media lives at the /storage URL, which collides with the
    # real storage/ directory blocked below, so it must be handled BEFORE that
    # deny rule. Serve the static file when the storage:link symlink is there;
    # otherwise fall through to Laravel, which streams it via MediaController.
    # Either way only storage/app/public is reachable - storage/logs,
    # storage/framework and app/private live outside it and have no path here.
    RewriteCond %{DOCUMENT_ROOT}/public/storage/$1 -f
    RewriteRule ^storage/(.*)$ public/storage/$1 [L]
    RewriteRule ^storage/(.+)$ public/index.php [L]

    # Never serve application directories
    RewriteRule ^(app|bootstrap|config|database|lang|node_modules|resources|routes|storage|tests|vendor)(/|$) - [F,L]

    # Route everything else into Laravel's public directory.
    # The (?!public/) guard stops the rewrite re-applying on Apache's second pass.
    RewriteRule ^(?!public/)(.*)$ public/$1 [L]
</IfModule>
